#include <windows.h>
#include "resource.h"

IDI_ICON_LIGHT ICON "../res/icon_light.ico"
IDI_ICON_DARK  ICON "../res/icon_dark.ico"
IDB_TOOLBAR    BITMAP "../res/toolbar.bmp"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    GRIN_VERSION_MAJOR, GRIN_VERSION_MINOR, GRIN_VERSION_PATCH, 0
 PRODUCTVERSION GRIN_VERSION_MAJOR, GRIN_VERSION_MINOR, GRIN_VERSION_PATCH, 0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "GRIN Renders In Notepad++: GitHub Flavored Markdown viewer with Mermaid"
            VALUE "FileVersion",      GRIN_VERSION_STR
            VALUE "InternalName",     "GRIN-Markdown"
            VALUE "OriginalFilename", "GRIN-Markdown.dll"
            VALUE "ProductName",      "GRIN-Markdown"
            VALUE "ProductVersion",   GRIN_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
